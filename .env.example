# All optional. See README "Setup" / "Handling the 18:37 UTC writz-lend switch".

# Overrides the writz-lend contract ID read from @writz/sdk's testnet preset.
# WRITZ_LEND_CONTRACT_ID=

# Overrides the bitcoin-spv contract ID read from @writz/sdk's testnet preset.
# BITCOIN_SPV_CONTRACT_ID=

# Where data/positions.json, data/history.json and data/topics.json are written.
# CENTINELA_DATA_DIR=./data
